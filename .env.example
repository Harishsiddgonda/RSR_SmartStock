# ==============================================================
# RSR SmartStock - Environment Variables Configuration
# ==============================================================

# Application Secret Key (Used for session signing & cookie encryption)
# Generate a random 32+ character hex string in production:
# python -c "import secrets; print(secrets.token_hex(32))"
SMARTSTOCK_SECRET=rsr-smartstock-enterprise-security-key-2026

# Port to bind (Render automatically injects PORT=10000)
PORT=5000

# Host binding (Use 0.0.0.0 on cloud/Docker, 127.0.0.1 on local)
HOST=0.0.0.0

# Python runtime version for Cloud builders (Render, Railway, Heroku)
PYTHON_VERSION=3.11.9

# Environment mode
FLASK_ENV=production
